import numpy as np
import time


def get_sin_wave_amplitude(freq, time):
    """Нормализованная амплитуда синуса в диапазоне [0, 1]."""
    return (np.sin(2 * np.pi * freq * time) + 1) / 2


def get_triangle_wave_amplitude(freq, time):
    """Нормализованная амплитуда треугольника в диапазоне [0, 1]."""
    period = 1 / freq
    phase = (time % period) / period      # фаза в [0, 1)

    if phase < 0.5:
        return 2 * phase                  # 0 -> 1
    else:
        return 2 * (1 - phase)            # 1 -> 0


def wait_for_sampling_period(sampling_frequency):
    """Ждёт один период дискретизации: T = 1 / sampling_frequency."""
    time.sleep(1 / sampling_frequency)


