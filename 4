import smbus


class MCP4725:
    """Драйвер 12-битного ЦАП MCP4725 через I2C-шину."""

    def __init__(self, dynamic_range, address=0x61, verbose=True):
        self.bus = smbus.SMBus(1)

        self.address = address
        self.wm = 0x00      # Write Mode: 0x00 — запись в DAC-регистр
        self.pds = 0x00     # Power-Down Selection: 0x00 — нормальный режим

        self.verbose = verbose
        self.dynamic_range = dynamic_range

    def deinit(self):
        """Закрывает I2C-шину (освобождает ресурс)."""
        self.bus.close()

    def set_number(self, number):
        """Записывает 12-битное число в ЦАП."""
        if not isinstance(number, int):
            print("На вход ЦАП можно подавать только целые числа")
            return

        if not (0 <= number <= 4095):
            print("Число выходит за разрядность MCP4725 (12 бит)")
            return

        first_byte = self.wm | self.pds | (number >> 8)
        second_byte = number & 0xFF
        self.bus.write_byte_data(self.address, first_byte, second_byte)

        if self.verbose:
            print(
                f"Число: {number}, отправленные по I2C данные: "
                f"[0x{(self.address << 1):02X}, "
                f"0x{first_byte:02X}, 0x{second_byte:02X}]\n"
            )

    def set_voltage(self, voltage):
        """Выставляет напряжение на выходе MCP4725.

        voltage — желаемое напряжение в вольтах в пределах dynamic_range.
        Код ЦАП рассчитывается как: number = 4095 * voltage / dynamic_range.
        """
        if not (0 <= voltage <= self.dynamic_range):
            print(
                f"Напряжение {voltage} В выходит за динамический диапазон "
                f"0..{self.dynamic_range} В"
            )
            return

        number = int(round(4095 * voltage / self.dynamic_range))
        self.set_number(number)


if __name__ == "__main__":
    dac = MCP4725(dynamic_range=3.3, address=0x61)

    try:
        while True:
            try:
                voltage = float(input("Введите напряжение (В): "))
                dac.set_voltage(voltage)
            except ValueError:
                print("Нужно ввести число")
    except KeyboardInterrupt:
        print("\nЗавершение работы")
    finally:
        dac.deinit()
